<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_marginTop="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:text="Monthly Stats"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#1E293B" />

            <Spinner
                android:id="@+id/spMonthPicker"
                android:layout_width="145dp"
                android:layout_height="38dp"
                android:foregroundTint="@color/black"
                />
        </LinearLayout>

        <!-- VISUAL SIDE-BY-SIDE TREND GRAPHS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Past Months Financial Trends"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#334155"
            android:layout_marginBottom="8dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:orientation="vertical"
                android:background="@color/white"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="8dp">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="#2E7D32"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Money Added"
                        android:textSize="10sp"
                        android:textColor="#475569"
                        android:layout_marginEnd="16dp"/>

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="#C62828"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Expenses"
                        android:textSize="10sp"
                        android:textColor="#475569"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:weightSum="3">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="bottom|center_horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="bottom">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="bottom|center_horizontal"
                                android:layout_marginEnd="3dp">
                                <TextView android:id="@+id/tvIncGraphAmt3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹0" android:textSize="8sp" android:textColor="#64748B"/>
                                <View android:id="@+id/vIncBar3" android:layout_width="14dp" android:layout_height="1dp" android:background="#A5D6A7" android:layout_marginVertical="2dp"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="bottom|center_horizontal"
                                android:layout_marginStart="3dp">
                                <TextView android:id="@+id/tvExpGraphAmt3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹0" android:textSize="8sp" android:textColor="#64748B"/>
                                <View android:id="@+id/vExpBar3" android:layout_width="14dp" android:layout_height="1dp" android:background="#EF9A9A" android:layout_marginVertical="2dp"/>
                            </LinearLayout>
                        </LinearLayout>

                        <TextView android:id="@+id/tvIncGraphLabel3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Month" android:textSize="10sp" android:textStyle="bold" android:textColor="#475569" android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="bottom|center_horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="bottom">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="bottom|center_horizontal"
                                android:layout_marginEnd="3dp">
                                <TextView android:id="@+id/tvIncGraphAmt2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹0" android:textSize="8sp" android:textColor="#64748B"/>
                                <View android:id="@+id/vIncBar2" android:layout_width="14dp" android:layout_height="1dp" android:background="#A5D6A7" android:layout_marginVertical="2dp"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="bottom|center_horizontal"
                                android:layout_marginStart="3dp">
                                <TextView android:id="@+id/tvExpGraphAmt2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹0" android:textSize="8sp" android:textColor="#64748B"/>
                                <View android:id="@+id/vExpBar2" android:layout_width="14dp" android:layout_height="1dp" android:background="#EF9A9A" android:layout_marginVertical="2dp"/>
                            </LinearLayout>
                        </LinearLayout>

                        <TextView android:id="@+id/tvIncGraphLabel2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Month" android:textSize="10sp" android:textStyle="bold" android:textColor="#475569" android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="bottom|center_horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="bottom">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="bottom|center_horizontal"
                                android:layout_marginEnd="3dp">
                                <TextView android:id="@+id/tvIncGraphAmt1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹0" android:textSize="8sp" android:textColor="#2E7D32"/>
                                <View android:id="@+id/vIncBar1" android:layout_width="14dp" android:layout_height="1dp" android:background="#2E7D32" android:layout_marginVertical="2dp"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="bottom|center_horizontal"
                                android:layout_marginStart="3dp">
                                <TextView android:id="@+id/tvExpGraphAmt1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹0" android:textSize="8sp" android:textColor="#C62828"/>
                                <View android:id="@+id/vExpBar1" android:layout_width="14dp" android:layout_height="1dp" android:background="#C62828" android:layout_marginVertical="2dp"/>
                            </LinearLayout>
                        </LinearLayout>

                        <TextView android:id="@+id/tvIncGraphLabel1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Month" android:textSize="10sp" android:textStyle="bold" android:textColor="#1E293B" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- FINANCIAL METRICS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Financial Metrics Breakdown"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#334155"
            android:layout_marginBottom="8dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="5dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Total Money Added" android:textColor="#475569" />
                    <TextView android:id="@+id/tvTotalIncome" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹ 0.00" android:textStyle="bold" android:textColor="#2E7D32" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="5dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Total Expenses" android:textColor="#475569" />
                    <TextView android:id="@+id/tvTotalExpense" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹ 0.00" android:textStyle="bold" android:textColor="#C62828" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="5dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Daily Spending Pace" android:textColor="#64748B" android:textSize="13sp"/>
                    <TextView android:id="@+id/tvDailyAverage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹ 0.00/day" android:textColor="#64748B" android:textSize="13sp" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E2E8F0" android:layout_marginVertical="6dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="5dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Lent to Friends" android:textColor="#475569" />
                    <TextView android:id="@+id/tvLentToFriends" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹ 0.00" android:textStyle="bold" android:textColor="#E65100" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="5dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Returned by Friends" android:textColor="#475569" />
                    <TextView android:id="@+id/tvReturnedByFriends" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹ 0.00" android:textStyle="bold" android:textColor="#1565C0" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="5dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Still Owed to You" android:textColor="#7C2D12" android:textSize="13sp"/>
                    <TextView android:id="@+id/tvPendingFriends" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹ 0.00" android:textColor="#7C2D12" android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E2E8F0" android:layout_marginVertical="6dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="5dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Monthly Savings Rate" android:textStyle="bold" android:textColor="#0F172A" />
                    <TextView android:id="@+id/tvSavingsRate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textStyle="bold" android:textColor="#0F172A" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ADVANCED INSIGHT HIGHLIGHTS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Advanced Tracking Insights"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#334155"
            android:layout_marginBottom="8dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Highest Single Transaction"
                    android:textSize="12sp"
                    android:textColor="#64748B" />
                <TextView
                    android:id="@+id/tvHighestTransaction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹ 0.00 (None)"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Most Frequent Transaction"
                    android:textSize="12sp"
                    android:textColor="#64748B" />
                <TextView
                    android:id="@+id/tvFrequentTransaction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="None"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>