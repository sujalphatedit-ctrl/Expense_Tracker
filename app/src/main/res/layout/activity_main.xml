<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Expense Tracker"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#1E293B" />

            <ImageView
                android:id="@+id/ivEye"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_view"
                android:contentDescription="Toggle Visibility"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="4dp" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#052E7D32"
                android:backgroundTint="#0A2E7D32"> <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pocket Money Balance"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#475569" />

                <TextView
                    android:id="@+id/tvPocketBalance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="₹ ****"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#2E7D32"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#0A1565C0">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Savings Balance"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#475569" />

                <TextView
                    android:id="@+id/tvSavingBalance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="₹ ****"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#0AEF6C00">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cash Balance"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#475569" />

                <TextView
                    android:id="@+id/tvCashBalance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="₹ ****"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#EF6C00"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quick Actions"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#334155"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginBottom="14dp">

            <Button
                android:id="@+id/btnAddMoney"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Add\nMoney"
                android:textSize="12sp"
                android:layout_marginEnd="6dp"
                android:paddingVertical="12dp"
                android:backgroundTint="#1976D2"
                android:textColor="@android:color/white"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btnAddExpense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Add\nExpense"
                android:textSize="12sp"
                android:layout_marginHorizontal="3dp"
                android:paddingVertical="12dp"
                android:backgroundTint="#D32F2F"
                android:textColor="@android:color/white"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btnAddFriend"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Friend\nMoney"
                android:textSize="12sp"
                android:layout_marginStart="6dp"
                android:paddingVertical="12dp"
                android:backgroundTint="#F57C00"
                android:textColor="@android:color/white"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Insights &amp; Logs"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#334155"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnHistory"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Transaction History"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#388E3C"
            android:textColor="@android:color/white"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/btnMonthlyAnalysis"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Monthly Analysis"
            android:textStyle="bold"
            android:textSize="15sp"
            android:backgroundTint="#4527A0"
            android:textColor="@android:color/white"
            app:cornerRadius="12dp" />
    </LinearLayout>
</ScrollView>