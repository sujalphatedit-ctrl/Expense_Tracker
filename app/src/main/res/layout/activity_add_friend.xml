<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Money Given to Friend"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#F57C00"
            android:paddingBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="20dp"
            android:elevation="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Amount"
                android:textColor="#212121"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="₹ Amount"
                android:inputType="number"
                android:textColor="#000000"
                android:textColorHint="#757575"
                android:padding="12dp"
                android:layout_marginBottom="18dp"
                android:background="@android:drawable/edit_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pay From Account"
                android:textColor="#212121"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rgAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbPocket"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pocket"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rbSaving"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Saving"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp" />

                <RadioButton
                    android:id="@+id/rbCash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cash"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Friend Name / Note"
                android:textColor="#212121"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp" />

            <EditText
                android:id="@+id/etFriendName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. John Doe"
                android:textColor="#000000"
                android:textColorHint="#757575"
                android:padding="12dp"
                android:layout_marginBottom="22dp"
                android:background="@android:drawable/edit_text" />

            <Button
                android:id="@+id/btnAddFriendMoney"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Send Money"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#F57C00"
                android:textColor="@android:color/white" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>